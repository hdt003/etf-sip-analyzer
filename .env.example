# App Configuration
APP_NAME="Buy the Dip Dashboard - Indian Mutual Funds & ETFs"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY="super-secret-jwt-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# Database Configuration (PostgreSQL for Supabase / Production, SQLite for Local)
# SQLite fallback: sqlite:///./etf_sip_analyzer.db
# PostgreSQL example: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL="sqlite:///./etf_sip_analyzer.db"

# Background Job Configuration
ENABLE_SCHEDULER=True
DAILY_SYNC_HOUR=18  # 6 PM IST after market close
DAILY_SYNC_MINUTE=30

# CORS Origins (Comma separated)
CORS_ORIGINS="*"
